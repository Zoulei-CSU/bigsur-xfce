      "itens": [
        {
          "pkg": "code",
          "nome": "Visual Studio Code",
          "desc": "微软的编辑器，带扩展和调试器",
          "fonte": "microsoft-vscode",
          "aviso": "向 apt 添加微软仓库，并把其签名密钥安装到 /usr/share/keyrings/microsoft-vscode.gpg。密钥只绑定该仓库，不再验证系统中的其他内容。此后微软可以向这台机器发送 code 包的更新。"
        },
        {
          "pkg": "docker-ce",
          "nome": "Docker（rootless）",
          "desc": "无 root 的容器，带 Compose 和 Buildx，为你的用户准备好",
          "fonte": "docker",
          "junto": [
            "docker-ce-cli",
            "containerd.io",
            "docker-buildx-plugin",
            "docker-compose-plugin",
            "docker-ce-rootless-extras",
            "uidmap",
            "dbus-user-session",
            "slirp4netns"
          ],
          "depois": "docker-rootless.sh",
          "aviso": "向 apt 添加 Docker 官方仓库，并把其密钥安装到 /usr/share/keyrings/docker.gpg，仅绑定该仓库。此后 Docker 可以向这台机器发送更新。之后会为你的用户配置 rootless 模式：守护进程以你的用户运行，root 守护进程被关闭。你的用户不会加入 docker 组，该组会赋予其等同 root 的权限。如果已安装 Debian 的 docker.io，apt 会替换它。"
        }
      ]
